#!/bin/sh
#
# sndocs — maintains the Skill's local Cache of ServiceNow product
# documentation, one Cache per Family.
#
# Dependency-free POSIX shell by design: no Node, no Python virtual
# environment, no package manager. `git` and a POSIX userland are the whole
# dependency list.
#
# The Cache is owned exclusively by this executable. It never reads, reuses,
# validates, or mutates any clone the user already has, and it writes nothing
# outside its own cache location.

set -eu

SNDOCS_DEFAULT_UPSTREAM='https://github.com/ServiceNow/ServiceNowDocs.git'

# The newest family as of the last time this file was touched. Used only when
# nothing is configured, and never silently: falling back to it is a guess
# about which release an instance runs, and the guess is warned about.
SNDOCS_NEWEST_FAMILY='australia'

# The project-level configuration file, looked for at and above the working
# directory. Family is a property of the codebase rather than of the machine,
# so this is the documented place to pin one.
SNDOCS_PROJECT_CONFIG='.sndocs'

# Initial Cone: the API reference publication, plus every publication index.
# Non-cone sparse patterns, because "every publication's index" is a glob
# across directories and cone mode can only express directory prefixes.
SNDOCS_INDEX_PATTERN='/markdown/*/index.md'

# Seven days, against upstream's roughly monthly publication cadence — enough
# margin that a refresh is never the reason an answer is late, and short enough
# that a family that has just shipped is picked up without asking.
SNDOCS_STALE_AFTER=604800

usage() {
	cat <<'EOF'
sndocs — local cache of ServiceNow product documentation, one cache per family.

Usage:
  sndocs sync    [--family <family>] [--upstream <repository>]
  sndocs widen   [--family <family>] --publication <publication> ...
  sndocs refresh [--family <family>]
  sndocs status  [--family <family>]
  sndocs index   [--family <family>]
  sndocs family  [--family <family>]
  sndocs verify  [--family <family>] [--routing <file>]
  sndocs help

Commands:
  family   Report the family every other command would work on, and where that
           family came from, as JSON on stdout.
  sync     Create the cache for a family if it does not exist: a blobless,
           shallow, sparse clone holding the API reference publication and
           every publication index. Records the resolved commit and the fetch
           timestamp. A second sync on a fresh cache is a no-op; a sync on a
           cache older than seven days refreshes it first.
  widen    Add publications to what the cache holds, pulling only the new
           content, and refreshing a stale cache first. Publications already
           cached are left alone. Fails if the publication is not published
           upstream for that family — which is what keeps "not cached"
           distinguishable from "not documented".
  refresh  Fetch the family again now and record the new commit and fetch
           timestamp, without waiting for the staleness window. If upstream
           cannot be reached, the existing cache is kept and its age reported.
  status   Report the family, commit, fetch timestamp, cache age, and both what
           is cached and what upstream publishes, as JSON on stdout. Exits
           non-zero if that family has no cache.
  index    Walk every cached topic in one pass and write a heading index —
           one greppable line per topic, holding its path, title, product
           area, canonical URL, and every first- and second-level heading —
           to the cache. A topic that is empty or whose frontmatter never
           closes is flagged rather than silently skipped. Written inside the
           cache, outside version control, and safe to re-run any time: it
           reads whatever the cone currently holds and overwrites the index
           in place.
  verify   Diff the curated routing table against the upstream structure the
           cache already holds, and report every publication that no longer
           exists, every entry topic that has moved or disappeared, and every
           entry topic no longer linked from its own publication's index, as
           JSON on stdout. Exits non-zero when it finds any discrepancy, zero
           when clean. Reads only what the cache already fetched — no entry
           costs a network round trip, and nothing is fetched on verify's own
           account. Structural drift only: a content refresh that changes a
           page without moving, renaming, or delisting it is invisible to
           this command.

Options:
  --family <family>       Documentation family to work on. Overrides every
                          configured source. When omitted, the family is
                          resolved as described below.
  --publication <name>    Publication to add to the cache. Repeat for several.
  --routing <file>        Routing table to verify. Defaults to the one shipped
                          next to this script, skills/sndocs/routing.tsv. The
                          override exists so the test suite can verify against
                          a small fixture table rather than the real one.
  --upstream <repository> Upstream documentation repository to clone from.
                          Defaults to $SNDOCS_UPSTREAM, else
                          https://github.com/ServiceNow/ServiceNowDocs.git.
                          This override exists so the test suite can point at a
                          small local fixture instead of downloading 269 MB of
                          monthly-changing upstream content. It is part of the
                          supported interface.

Family resolution, highest wins:
  1. --family on the invocation.
  2. The nearest .sndocs file at or above the working directory. This is the
     documented place to pin a family: family is a property of the codebase,
     not of the machine, so committing it means teammates and agents inherit
     it, and changing directory between client repositories changes the
     documentation set with no other action.
  3. $XDG_CONFIG_HOME/sndocs/config, for a machine-wide default.
  4. The newest family, with a warning that no family was configured.

  Both files are key=value lines; `#` starts a comment. The key is `family`.
  Every command reports which family it resolved and where that came from.

  A family whose branch upstream no longer publishes is reported as out of
  support and exits non-zero. Upstream deletes the oldest family when a new
  release reaches general availability, so this will happen to a pinned family
  eventually. It is a fact about the instance's release, never a reason to
  quietly answer from a different family.

Environment:
  SNDOCS_UPSTREAM   Default for --upstream.
  SNDOCS_NOW        Unix timestamp to treat as the current time. Exists so the
                    test suite can cross the seven-day staleness window without
                    waiting a week. Part of the supported interface.
  XDG_CACHE_HOME    Cache location root (default: ~/.cache). The cache lives at
                    $XDG_CACHE_HOME/sndocs/<family>.
  XDG_CONFIG_HOME   Configuration root (default: ~/.config). The user-level
                    configuration lives at $XDG_CONFIG_HOME/sndocs/config.

Documentation is fetched at runtime and never redistributed. Every cache
records which upstream snapshot it came from, so a stale answer is
attributable rather than mysterious.
EOF
}

die() {
	printf 'sndocs: %s\n' "$1" >&2
	exit 1
}

note() {
	printf 'sndocs: %s\n' "$1" >&2
}

# ------------------------------------------------------------------ locations

cache_root() {
	printf '%s/sndocs\n' "${XDG_CACHE_HOME:-$HOME/.cache}"
}

config_root() {
	printf '%s/sndocs\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

# default_routing_file — the curated routing table shipped next to this
# script, resolved from $0 rather than assumed to be the working directory:
# `verify` has to find it regardless of where it is invoked from.
default_routing_file() {
	printf '%s/skills/sndocs/routing.tsv\n' "$(cd "$(dirname "$0")/.." && pwd)"
}

user_config_file() {
	printf '%s/config\n' "$(config_root)"
}

# Family and publication names become branch names, path segments, and sparse
# patterns, so each is checked before any of those uses — nothing outside the
# cache location may be created, read, or modified, and these names are the
# only user-supplied components of that path.
assert_path_segment() {
	# assert_path_segment <kind> <name> <where it came from, or empty>
	case $2 in
	'' | *[!a-zA-Z0-9._-]* | .* | *..*)
		# Named with its origin when it has one: a value that came from a
		# configuration file is only fixable if the file is named.
		if [ -n "$3" ]; then
			die "not a usable $1 name: '$2' in $3"
		fi
		die "not a usable $1 name: '$2'"
		;;
	esac
}

assert_family_name() {
	# assert_family_name <name> [<where it came from>]
	assert_path_segment family "$1" "${2:-}"
}

assert_publication_name() {
	assert_path_segment publication "$1" ''
}

family_dir() {
	printf '%s/%s\n' "$(cache_root)" "$1"
}

# ------------------------------------------------------ key=value files
#
# Three files in this design are line-oriented key=value: the Snapshot, which
# this executable writes, and the two configuration files, which people write.
# One reader serves all three, tolerant enough for the handwritten ones.

# trim <text> — the text without surrounding blanks.
trim() {
	_trimmed=$1
	_trimmed=${_trimmed#"${_trimmed%%[![:blank:]]*}"}
	_trimmed=${_trimmed%"${_trimmed##*[![:blank:]]}"}
	printf '%s\n' "$_trimmed"
}

# kv_read <file> <key> — prints the value, or fails if the key is absent.
# Blank lines and `#` comments are skipped. A value may itself contain `=`,
# because upstream URLs do.
kv_read() {
	[ -f "$1" ] || return 1
	# `|| [ -n "$_line" ]` so a final line without a trailing newline is still
	# read — a handwritten file often has none.
	while IFS= read -r _line || [ -n "$_line" ]; do
		_line=$(trim "$_line")
		case $_line in
		'' | '#'*) continue ;;
		*'='*) ;;
		*) continue ;;
		esac
		if [ "$(trim "${_line%%=*}")" = "$2" ]; then
			trim "${_line#*=}"
			return 0
		fi
	done <"$1"
	return 1
}

# ------------------------------------------------------------ family resolution
#
# Which Family every other command works on, and where that came from.
# Precedence, highest first: an explicit argument, the project configuration
# file, the user configuration file, then the newest family with a warning.
#
# The project file is the documented default because Family is a property of
# the codebase rather than of the machine — an update-set repository for a
# Zurich client is Zurich permanently, and committing that fact means teammates
# and agents inherit it without being told. A consultant moving between client
# repositories changes documentation sets by changing directory.

FAMILY=''
FAMILY_SOURCE=''
FAMILY_SOURCE_PATH=''

# find_project_config — the nearest project configuration file at or above the
# working directory, or non-zero if there is none.
find_project_config() {
	_dir=$(pwd)
	while :; do
		if [ -f "$_dir/$SNDOCS_PROJECT_CONFIG" ]; then
			printf '%s/%s\n' "${_dir%/}" "$SNDOCS_PROJECT_CONFIG"
			return 0
		fi
		[ "$_dir" != '/' ] || return 1
		_dir=$(dirname "$_dir")
	done
}

# resolve_family [<explicit family>] — sets FAMILY, FAMILY_SOURCE and
# FAMILY_SOURCE_PATH. A configured family is validated here, in the shell that
# can still die: a bad value in a file is fatal and names the file, never
# quietly skipped in favour of the next source.
resolve_family() {
	FAMILY_SOURCE_PATH=''

	if [ -n "${1:-}" ]; then
		assert_family_name "$1"
		FAMILY=$1
		FAMILY_SOURCE=argument
		return 0
	fi

	if _file=$(find_project_config); then
		if _value=$(kv_read "$_file" family); then
			# The key is present, so a bad or empty value is this file's
			# mistake to report — never a reason to fall through to the next
			# source as though it had said nothing.
			assert_family_name "$_value" "$_file"
			FAMILY=$_value
			FAMILY_SOURCE=project
			FAMILY_SOURCE_PATH=$_file
			return 0
		fi
	fi

	_file=$(user_config_file)
	if _value=$(kv_read "$_file" family); then
		assert_family_name "$_value" "$_file"
		FAMILY=$_value
		FAMILY_SOURCE=user
		FAMILY_SOURCE_PATH=$_file
		return 0
	fi

	FAMILY=$SNDOCS_NEWEST_FAMILY
	FAMILY_SOURCE=default
}

# report_family — says which family is being worked on and where that came
# from, so no answer is ever attributed to a family nobody chose.
report_family() {
	case $FAMILY_SOURCE in
	argument)
		note "family $FAMILY, from --family"
		;;
	project | user)
		note "family $FAMILY, from $FAMILY_SOURCE_PATH"
		;;
	default)
		note "no family configured; using the newest family '$FAMILY'. Pin one with 'family=<family>' in $SNDOCS_PROJECT_CONFIG at the root of this repository"
		;;
	esac
}

# ------------------------------------------------------------- out of support
#
# Upstream deletes the oldest Family branch when a new release reaches general
# availability, so a pinned Family eventually ceases to exist. That is
# actionable information about the release an instance runs — reported and
# fatal, never papered over by answering from a Family nobody chose.

# upstream_publishes_no_branch <upstream> <family> — true only when upstream
# can be reached and publishes no branch for the family. False when upstream
# cannot be reached: offline is a degraded mode and says nothing about what is
# still published, and telling someone their release is out of support because
# their network dropped would be worse than saying nothing.
upstream_publishes_no_branch() {
	_refs=$(git ls-remote --heads -- "$1" "refs/heads/$2" 2>/dev/null) || return 1
	[ -z "$_refs" ]
}

die_out_of_support() {
	# die_out_of_support <upstream> <family>
	die "family '$2' is out of support: $1 no longer publishes a branch for it. ServiceNow withdraws the oldest family when a new release reaches general availability. Pin a supported family, or ask about the release the instance actually runs"
}

die_not_published() {
	# die_not_published <upstream> <family>
	die "family '$2' is not published by $1: there is no branch for it"
}

# ----------------------------------------------------------------------- time
#
# One clock, read in one place. SNDOCS_NOW overrides it so the seven-day
# staleness window can be crossed in a test without waiting a week.

now_epoch() {
	if [ -n "${SNDOCS_NOW:-}" ]; then
		printf '%s\n' "$SNDOCS_NOW"
	else
		date -u +%s
	fi
}

# BSD date spells this -r, GNU date spells it -d @; try both rather than
# depending on which userland this is.
epoch_to_iso() {
	date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
		date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ
}

# A cache's age is what makes a stale answer attributable, so it is reported
# rather than suppressed. A clock that has gone backwards reads as new rather
# than as negative.
age_seconds() {
	# age_seconds <fetched_epoch>
	_age=$(($(now_epoch) - $1))
	[ "$_age" -ge 0 ] || _age=0
	printf '%s\n' "$_age"
}

age_human() {
	# age_human <seconds> — for the messages a person reads.
	if [ "$1" -lt 3600 ]; then
		printf 'less than an hour old\n'
	elif [ "$1" -lt 86400 ]; then
		_hours=$(($1 / 3600))
		if [ "$_hours" -eq 1 ]; then
			printf '1 hour old\n'
		else
			printf '%s hours old\n' "$_hours"
		fi
	else
		_days=$(($1 / 86400))
		if [ "$_days" -eq 1 ]; then
			printf '1 day old\n'
		else
			printf '%s days old\n' "$_days"
		fi
	fi
}

# ------------------------------------------------------------------- snapshot
#
# The record of which upstream snapshot a Cache came from and when it was
# taken. Line-oriented key=value; values never contain newlines.

snapshot_write() {
	# snapshot_write <file> <family> <upstream> <commit> <fetched_at>
	#                <fetched_epoch>
	#
	# The fetch time is recorded twice on purpose: once for a person to read,
	# once as an integer, so that measuring a cache's age never depends on
	# parsing a timestamp in portable shell.
	cat >"$1" <<EOF
family=$2
upstream=$3
commit=$4
fetched_at=$5
fetched_epoch=$6
EOF
}

snapshot_read() {
	# snapshot_read <file> <key> — prints the value, or fails. A Snapshot is
	# one of the key=value files kv_read handles.
	kv_read "$1" "$2"
}

# --------------------------------------------------------------------- output

# Publications travel as newline-separated lists, because that is what git
# hands back and what the output takes. These two are the whole vocabulary for
# working with them.

# contains_line <list> <item> — is that item one of the lines?
contains_line() {
	printf '%s\n' "$1" | grep -qxF "$2"
}

json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# json_array_elements <list> — a newline-separated list as JSON array elements.
# Takes the list as an argument rather than on stdin so that a failure to
# produce it fails the command, instead of being swallowed by a pipeline and
# printed as an empty array.
json_array_elements() {
	[ -n "$1" ] || return 0
	_separator=''
	printf '%s\n' "$1" | while read -r _item; do
		printf '%s"%s"' "$_separator" "$(json_escape "$_item")"
		_separator=', '
	done
}

# ----------------------------------------------------------------------- cone
#
# Read back from git's own sparse-checkout state and from the checkout itself,
# rather than from a separate manifest — there is no second source of truth to
# desynchronize. The Cone is what makes "not downloaded" distinguishable from
# "not documented", so it has to be reported exactly.

cone_publications() {
	# cone_publications <repo> — publications held in full, one per line.
	git -C "$1" sparse-checkout list | while read -r _pattern; do
		case "$_pattern" in
		/markdown/*/)
			_rest=${_pattern#/markdown/}
			printf '%s\n' "${_rest%/}"
			;;
		esac
	done | LC_ALL=C sort
}

# upstream_publications <repo> — every publication the family publishes, one
# per line, read from the tree the clone already has. A blobless clone carries
# every tree, so this needs no network and no separate manifest. It is what
# lets "not cached" be told apart from "not documented".
upstream_publications() {
	# Read before it is filtered, and refused if it comes back empty: a git
	# failure that reached the caller as an empty list would say "upstream
	# publishes nothing", which is the one thing this must never say by
	# accident.
	_tree=$(git -C "$1" ls-tree -d --name-only HEAD markdown/) || _tree=''
	[ -n "$_tree" ] ||
		die "could not read the publication list from the cache at $1. Remove it and sync again"
	printf '%s\n' "$_tree" |
		sed -e 's|^markdown/||' -e 's|/$||' |
		LC_ALL=C sort
}

cone_publication_indexes() {
	# cone_publication_indexes <repo> — publications whose index is checked
	# out, one per line.
	(
		cd "$1" || return 0
		for _index in markdown/*/index.md; do
			[ -f "$_index" ] || continue
			_rest=${_index#markdown/}
			printf '%s\n' "${_rest%/index.md}"
		done
	) | LC_ALL=C sort
}

# --------------------------------------------------------------- cache access

assert_cache_exists() {
	# assert_cache_exists <dir> <family>
	[ -d "$1/repo/.git" ] && [ -f "$1/snapshot" ] ||
		die "no cache for family '$2'. Run: sndocs sync --family $2"
}

cache_age() {
	# cache_age <dir> <family> — age in seconds of the recorded snapshot.
	_fetched_epoch=$(snapshot_read "$1/snapshot" fetched_epoch) ||
		die "cache for family '$2' has no recorded fetch time. Remove $1 and sync again"
	age_seconds "$_fetched_epoch"
}

# fetch_family <dir> <family> — fetches the family again and re-records the
# snapshot. Returns non-zero, leaving the cache and its snapshot as they were,
# when upstream cannot be reached: offline is a degraded mode, not a failure,
# and a cache that still answers is worth more than a command that fails.
fetch_family() {
	_dir=$1
	_family=$2

	git -C "$_dir/repo" fetch --quiet --depth 1 origin "$_family" >&2 || return 1
	git -C "$_dir/repo" reset --quiet --hard FETCH_HEAD >&2 || return 1

	_commit=$(git -C "$_dir/repo" rev-parse HEAD)
	_epoch=$(now_epoch)
	_upstream=$(snapshot_read "$_dir/snapshot" upstream) || _upstream=''
	snapshot_write "$_dir/snapshot" "$_family" "$_upstream" "$_commit" \
		"$(epoch_to_iso "$_epoch")" "$_epoch"
}

# refresh_cache <dir> <family> <age-seconds> — fetches again and says what
# happened, in the one wording both `sync` and `refresh` use. Never fails while
# a cache is present; an unreachable upstream is reported with the cache's age
# so the caller can stamp that age on any answer it gives.
refresh_cache() {
	if fetch_family "$1" "$2"; then
		_commit=$(snapshot_read "$1/snapshot" commit) || _commit='?'
		_fetched_at=$(snapshot_read "$1/snapshot" fetched_at) || _fetched_at='?'
		printf 'sndocs: refreshed %s to %s (%s)\n' \
			"$2" "$_commit" "$_fetched_at" >&2
	else
		# A fetch fails both when upstream is unreachable and when the family
		# has been withdrawn. The second is not a degraded mode to shrug off:
		# a cache nobody can refresh again, answered from silently, is exactly
		# the confident-and-wrong output this project exists to prevent. There
		# is no typo to consider here — the cache is proof this family was
		# published once.
		_upstream=$(snapshot_read "$1/snapshot" upstream) || _upstream=''
		if [ -n "$_upstream" ] && upstream_publishes_no_branch "$_upstream" "$2"; then
			die_out_of_support "$_upstream" "$2"
		fi

		printf 'sndocs: could not reach upstream; keeping the cache for %s, %s\n' \
			"$2" "$(age_human "$3")" >&2
	fi
}

# ----------------------------------------------------------------------- sync

cmd_sync() {
	family=''
	upstream=${SNDOCS_UPSTREAM:-$SNDOCS_DEFAULT_UPSTREAM}

	while [ "$#" -gt 0 ]; do
		case $1 in
		--family)
			[ "$#" -ge 2 ] && [ -n "$2" ] || die '--family needs a value'
			family=$2
			shift 2
			;;
		--upstream)
			[ "$#" -ge 2 ] || die '--upstream needs a value'
			upstream=$2
			shift 2
			;;
		-h | --help)
			usage
			return 0
			;;
		*) die "unknown option for sync: $1" ;;
		esac
	done

	resolve_family "$family"
	report_family
	family=$FAMILY
	dir=$(family_dir "$family")

	# A cache inside the staleness window is left alone: syncing again must
	# not re-clone. Past the window it is refreshed in place, so that using
	# the skill is what keeps the cache current.
	if [ -d "$dir/repo/.git" ] && [ -f "$dir/snapshot" ]; then
		recorded=$(snapshot_read "$dir/snapshot" upstream) || recorded=''
		# Provenance is the point of recording the snapshot, so a cache
		# built from a different upstream is a mismatch to report, not a
		# cache to hand back.
		if [ "$recorded" != "$upstream" ]; then
			die "cache for family '$family' came from $recorded, not $upstream. Remove $dir and sync again"
		fi

		age=$(cache_age "$dir" "$family")
		if [ "$age" -lt "$SNDOCS_STALE_AFTER" ]; then
			printf 'sndocs: cache for %s is present at %s and %s\n' \
				"$family" "$dir" "$(age_human "$age")" >&2
			return 0
		fi

		refresh_cache "$dir" "$family" "$age"
		return 0
	fi

	mkdir -p "$dir"

	# Clone into a temporary path and move it into place, so an interrupted
	# sync never leaves a half-built cache that later looks fresh.
	staging=$(mktemp -d "$dir/.staging.XXXXXX")
	trap 'rm -rf "$staging"' EXIT
	trap 'rm -rf "$staging"; exit 130' INT
	trap 'rm -rf "$staging"; exit 143' TERM

	if ! git clone \
		--filter=blob:none \
		--no-checkout \
		--depth 1 \
		--single-branch \
		--branch "$family" \
		-- "$upstream" "$staging" >&2; then
		rm -rf "$staging"
		rmdir "$dir" 2>/dev/null || true
		# Asked only once the clone has failed, so the ordinary path costs one
		# network round trip rather than two — and so the answer to "why did
		# that fail" distinguishes a withdrawn family from an unreachable
		# upstream instead of blaming the network for both.
		if upstream_publishes_no_branch "$upstream" "$family"; then
			# A family that was pinned, or fallen back to, is one nobody just
			# typed: it was chosen because an instance runs that release, so
			# its absence means the release is out of support. A family named
			# on the command line and published nowhere is likelier a typo,
			# and telling someone to migrate their instance over a misspelling
			# would be its own confidently-wrong answer.
			if [ "$FAMILY_SOURCE" = argument ]; then
				die_not_published "$upstream" "$family"
			fi
			die_out_of_support "$upstream" "$family"
		fi
		die "could not clone family '$family' from $upstream"
	fi

	git -C "$staging" sparse-checkout init --no-cone >/dev/null 2>&1 ||
		die 'git is too old for sparse checkout; git 2.25 or newer is required'
	git -C "$staging" sparse-checkout set \
		"$SNDOCS_INDEX_PATTERN" \
		'/markdown/api-reference/' >/dev/null
	git -C "$staging" checkout "$family" >/dev/null 2>&1 ||
		die "could not check out family '$family'"

	commit=$(git -C "$staging" rev-parse HEAD)
	fetched_epoch=$(now_epoch)
	fetched_at=$(epoch_to_iso "$fetched_epoch")

	rm -rf "$dir/repo"
	mv "$staging" "$dir/repo"
	trap - EXIT INT TERM

	snapshot_write "$dir/snapshot" "$family" "$upstream" "$commit" \
		"$fetched_at" "$fetched_epoch"

	printf 'sndocs: cached %s at %s (%s)\n' "$family" "$commit" "$fetched_at" >&2
}

# ---------------------------------------------------------------------- widen
#
# The Cone extends to cover a publication a query needs, pulling only the new
# content into the clone that is already there. Widening is incremental by
# construction: the sparse patterns grow, and git fetches the blobs the new
# patterns bring into the checkout.

cmd_widen() {
	family=''
	publications=''

	while [ "$#" -gt 0 ]; do
		case $1 in
		--family)
			[ "$#" -ge 2 ] && [ -n "$2" ] || die '--family needs a value'
			family=$2
			shift 2
			;;
		--publication)
			[ "$#" -ge 2 ] || die '--publication needs a value'
			# Checked here, before the name is ever collected into a list
			# that is later split on whitespace — validation behind an
			# expansion is validation of the wrong thing.
			assert_publication_name "$2"
			publications="$publications$2
"
			shift 2
			;;
		-h | --help)
			usage
			return 0
			;;
		*) die "unknown option for widen: $1" ;;
		esac
	done

	resolve_family "$family"
	report_family
	family=$FAMILY
	[ -n "$publications" ] || die 'widen needs at least one --publication'

	dir=$(family_dir "$family")
	assert_cache_exists "$dir" "$family"

	# Widening is a use of the cache, so a stale cache is refreshed before it
	# is extended. Pulling a publication down at a three-week-old commit,
	# while the rest of the cache moved on, would make the cone internally
	# inconsistent about which snapshot it holds.
	age=$(cache_age "$dir" "$family")
	if [ "$age" -ge "$SNDOCS_STALE_AFTER" ]; then
		refresh_cache "$dir" "$family" "$age"
	fi

	available=$(upstream_publications "$dir/repo")
	cached=$(cone_publications "$dir/repo")

	# Everything is checked before anything is added, so a request naming one
	# publication that does not exist leaves the cone exactly as it was.
	# Every name here has already passed assert_publication_name, so the
	# unquoted expansion has nothing left to split or glob.
	wanted=''
	for publication in $publications; do
		# The distinction the whole skill rests on: a publication upstream
		# does not carry is absent from the documentation, not merely
		# absent from this cache.
		contains_line "$available" "$publication" ||
			die "publication '$publication' is not published upstream for family '$family'"
		if contains_line "$cached" "$publication"; then
			continue
		fi
		wanted="$wanted$publication
"
	done

	if [ -z "$wanted" ]; then
		printf 'sndocs: cache for %s already holds every publication asked for\n' \
			"$family" >&2
		return 0
	fi

	# The patterns as they stand. git unwinds its own failed `add`, but the
	# guarantee that a failed widening leaves the cone where it was is this
	# command's to keep, not git's to be trusted with.
	previous=$(git -C "$dir/repo" sparse-checkout list)

	set --
	for publication in $wanted; do
		set -- "$@" "/markdown/$publication/"
	done

	if ! git -C "$dir/repo" sparse-checkout add "$@" >&2; then
		printf '%s\n' "$previous" |
			git -C "$dir/repo" sparse-checkout set --no-cone --stdin >&2 || true
		die "could not widen the cache for family '$family'"
	fi

	printf 'sndocs: cache for %s now holds %s\n' \
		"$family" "$(printf '%s' "$wanted" | tr '\n' ' ')" >&2
}

# -------------------------------------------------------------------- refresh

cmd_refresh() {
	family=''

	while [ "$#" -gt 0 ]; do
		case $1 in
		--family)
			[ "$#" -ge 2 ] && [ -n "$2" ] || die '--family needs a value'
			family=$2
			shift 2
			;;
		-h | --help)
			usage
			return 0
			;;
		*) die "unknown option for refresh: $1" ;;
		esac
	done

	resolve_family "$family"
	report_family
	family=$FAMILY
	dir=$(family_dir "$family")
	assert_cache_exists "$dir" "$family"

	refresh_cache "$dir" "$family" "$(cache_age "$dir" "$family")"
}

# --------------------------------------------------------------------- status

cmd_status() {
	family=''

	while [ "$#" -gt 0 ]; do
		case $1 in
		--family)
			[ "$#" -ge 2 ] && [ -n "$2" ] || die '--family needs a value'
			family=$2
			shift 2
			;;
		-h | --help)
			usage
			return 0
			;;
		*) die "unknown option for status: $1" ;;
		esac
	done

	resolve_family "$family"
	report_family
	family=$FAMILY
	dir=$(family_dir "$family")

	assert_cache_exists "$dir" "$family"

	commit=$(snapshot_read "$dir/snapshot" commit) ||
		die "cache for family '$family' has no recorded commit. Remove $dir and sync again"
	fetched_at=$(snapshot_read "$dir/snapshot" fetched_at) ||
		die "cache for family '$family' has no recorded fetch timestamp. Remove $dir and sync again"
	upstream=$(snapshot_read "$dir/snapshot" upstream) || upstream=''

	# Reported, never suppressed: an answer drawn from a stale cache is only
	# attributable if the caller is told how old the cache is.
	age=$(cache_age "$dir" "$family")
	if [ "$age" -lt "$SNDOCS_STALE_AFTER" ]; then stale=false; else stale=true; fi

	# status reports; it does not fetch. A stale cache is named as stale here
	# and refreshed by sync, widen, or refresh — a command whose whole job is
	# to say what the cache is should not change what the cache is.
	publications=$(cone_publications "$dir/repo")
	available=$(upstream_publications "$dir/repo")
	publication_indexes=$(cone_publication_indexes "$dir/repo")

	printf '{\n'
	printf '  "family": "%s",\n' "$(json_escape "$family")"
	printf '  "family_source": "%s",\n' "$(json_escape "$FAMILY_SOURCE")"
	printf '  "family_source_path": "%s",\n' "$(json_escape "$FAMILY_SOURCE_PATH")"
	printf '  "commit": "%s",\n' "$(json_escape "$commit")"
	printf '  "fetched_at": "%s",\n' "$(json_escape "$fetched_at")"
	printf '  "age_seconds": %s,\n' "$age"
	printf '  "stale": %s,\n' "$stale"
	printf '  "stale_after_seconds": %s,\n' "$SNDOCS_STALE_AFTER"
	printf '  "upstream": "%s",\n' "$(json_escape "$upstream")"
	printf '  "cache": "%s",\n' "$(json_escape "$dir/repo")"
	printf '  "publications": ['
	json_array_elements "$publications"
	printf '],\n'
	printf '  "available_publications": ['
	json_array_elements "$available"
	printf '],\n'
	printf '  "publication_indexes": ['
	json_array_elements "$publication_indexes"
	printf ']\n'
	printf '}\n'
}

# ---------------------------------------------------------------------- index
#
# The heading index: one greppable record per cached topic, regenerated from
# whatever the cone currently holds. Unlike a hand-maintained map, a stale
# entry cannot exist — the whole file is rebuilt from the checkout in one
# pass, never patched in place.
#
# One awk process handles every topic, reading filenames from a list file
# rather than off argv, so the command line's length has nothing to do with
# how many topics are cached. A record is plain `{...}` JSON, one per line:
# grepping for a heading or a title needs no parser, only the text.

# index_file <dir> — where a family's heading index lives: alongside the
# snapshot, never inside the git working tree it describes, so a `reset
# --hard` on refresh can never touch it.
index_file() {
	printf '%s/index.jsonl\n' "$1"
}

cmd_index() {
	family=''

	while [ "$#" -gt 0 ]; do
		case $1 in
		--family)
			[ "$#" -ge 2 ] && [ -n "$2" ] || die '--family needs a value'
			family=$2
			shift 2
			;;
		-h | --help)
			usage
			return 0
			;;
		*) die "unknown option for index: $1" ;;
		esac
	done

	resolve_family "$family"
	report_family
	family=$FAMILY
	dir=$(family_dir "$family")
	assert_cache_exists "$dir" "$family"

	repo="$dir/repo"
	list=$(mktemp "$dir/.index-files.XXXXXX")
	staging=$(mktemp "$dir/.index.XXXXXX")
	trap 'rm -f "$list" "$staging"' EXIT INT TERM

	(cd "$repo" && find markdown -type f -name '*.md' | LC_ALL=C sort) >"$list"

	# One record per line: path, title, product area, canonical URL, a status
	# of ok/empty/truncated/unreadable, and every level-1 and level-2 heading
	# verbatim (marker included), so the heading text itself is what a grep
	# matches. Headings are not looked for inside fenced code blocks, since a
	# shell or YAML example's own comments are not the topic's structure.
	#
	# A topic missing a frontmatter field upstream gets an empty string for
	# it rather than failing the whole run — a usable record beats none.
	# "truncated" means the frontmatter block was opened but never closed:
	# the shape a build that stopped mid-file leaves behind. "unreadable"
	# means the file could not even be opened, which is a local problem —
	# never the same status as a genuinely empty upstream file.
	awk -v repo_prefix="$repo/" '
	function esc(s) {
		gsub(/\\/, "\\\\", s)
		gsub(/"/, "\\\"", s)
		return s
	}
	function trim(s) {
		sub(/^[ \t]+/, "", s)
		sub(/[ \t]+$/, "", s)
		return s
	}
	{
		relpath = $0
		fname = repo_prefix relpath
		title = ""
		product_area = ""
		canonical_url = ""
		headings = ""
		in_frontmatter = 0
		in_code_fence = 0
		nlines = 0

		# rc distinguishes a file that opened and read zero lines (empty)
		# from one that could not be opened at all (unreadable) — the two
		# must never collapse into the same status, or a local read failure
		# would be reported the way an upstream build defect is.
		while ((rc = (getline line < fname)) > 0) {
			nlines++
			sub(/\r$/, "", line)
			if (nlines == 1 && line == "---") {
				in_frontmatter = 1
				continue
			}
			if (in_frontmatter) {
				if (line == "---") {
					in_frontmatter = 0
					continue
				}
				if (line ~ /^title:/) {
					title = trim(substr(line, index(line, ":") + 1))
				} else if (line ~ /^product_area:/) {
					product_area = trim(substr(line, index(line, ":") + 1))
				} else if (line ~ /^canonical_url:/) {
					canonical_url = trim(substr(line, index(line, ":") + 1))
				}
				continue
			}
			if (line ~ /^(```|~~~)/) {
				in_code_fence = !in_code_fence
				continue
			}
			if (in_code_fence) {
				continue
			}
			if (line ~ /^# / || line ~ /^## /) {
				headings = headings (headings == "" ? "" : ",") "\"" esc(line) "\""
			}
		}
		close(fname)

		if (rc < 0) {
			status = "unreadable"
		} else if (nlines == 0) {
			status = "empty"
		} else if (in_frontmatter) {
			status = "truncated"
		} else {
			status = "ok"
		}

		printf "{\"path\":\"%s\",\"title\":\"%s\",\"product_area\":\"%s\",\"canonical_url\":\"%s\",\"status\":\"%s\",\"headings\":[%s]}\n", \
			esc(relpath), esc(title), esc(product_area), esc(canonical_url), status, headings
	}
	' "$list" >"$staging"

	mv "$staging" "$(index_file "$dir")"
	trap - EXIT INT TERM
	rm -f "$list"

	count=$(wc -l <"$(index_file "$dir")" | tr -d '[:space:]')
	printf 'sndocs: indexed %s topics for %s at %s\n' \
		"$count" "$family" "$(index_file "$dir")" >&2
}

# --------------------------------------------------------------------- family
#
# What every other command resolved before it did anything, on its own, so that
# "which family am I about to get" is answerable without a cache, without the
# network, and without running something that changes state.

cmd_family() {
	family=''

	while [ "$#" -gt 0 ]; do
		case $1 in
		--family)
			[ "$#" -ge 2 ] && [ -n "$2" ] || die '--family needs a value'
			family=$2
			shift 2
			;;
		-h | --help)
			usage
			return 0
			;;
		*) die "unknown option for family: $1" ;;
		esac
	done

	resolve_family "$family"
	report_family

	printf '{\n'
	printf '  "family": "%s",\n' "$(json_escape "$FAMILY")"
	printf '  "source": "%s",\n' "$(json_escape "$FAMILY_SOURCE")"
	printf '  "source_path": "%s",\n' "$(json_escape "$FAMILY_SOURCE_PATH")"
	printf '  "cache": "%s"\n' "$(json_escape "$(family_dir "$FAMILY")/repo")"
	printf '}\n'
}

# ---------------------------------------------------------------------- verify
#
# Diffs the curated routing table against the upstream structure the cache
# already holds, so a maintainer learns when a rename, a removed publication,
# or a resolved filename collision has moved underneath a routing entry —
# rather than an agent quietly routing toward a path that no longer means
# what the table's note says it means.
#
# Three drift shapes, reported separately because each has a different fix:
# a publication the table names no longer exists upstream; an entry topic
# that has moved or disappeared within a publication that still exists; and
# an entry topic no longer linked from that publication's own index, the
# structural residue a rename or a resolved collision leaves behind even
# when the old path happens to still resolve.
#
# Reads only what the cache already fetched: a blobless clone carries every
# tree even outside the checked-out cone, so `git ls-tree` resolves any path
# without pulling its blob, and every publication's index.md is part of the
# initial cone regardless of what has been widened to. No entry costs a
# network round trip, and nothing here fetches on its own — a stale cache is
# still exactly what it was the last time something synced or refreshed it.
#
# This is structural drift only. A monthly content refresh that changes what
# a page says without moving, renaming, or delisting it is invisible to this
# command, on purpose — see its own help text and note() output below.

# verify_entry_exists <repo> <publication> <entry_path> — true if the entry
# resolves to a real tree entry, checked without touching its blob content.
verify_entry_exists() {
	[ -n "$(git -C "$1" ls-tree HEAD -- "markdown/$2/$3" 2>/dev/null)" ]
}

# verify_entry_linked <repo> <publication> <entry_path> — true if the
# publication's own index links the entry by its full relative path.
# Deliberately not a filename-alone fallback: two files that share a
# basename under different subdirectories — the resolved-collision shape
# this command exists to catch — would let one mask drift in the other.
verify_entry_linked() {
	_index="$1/markdown/$2/index.md"
	[ -f "$_index" ] || return 0
	grep -qF "$3" "$_index"
}

verify_emit() {
	# verify_emit <type> <concept> <publication> <entry_path> <detail>
	printf '{"type":"%s","concept":"%s","publication":"%s","entry_path":"%s","detail":"%s"}\n' \
		"$(json_escape "$1")" "$(json_escape "$2")" "$(json_escape "$3")" \
		"$(json_escape "$4")" "$(json_escape "$5")"
}

cmd_verify() {
	family=''
	routing=''

	while [ "$#" -gt 0 ]; do
		case $1 in
		--family)
			[ "$#" -ge 2 ] && [ -n "$2" ] || die '--family needs a value'
			family=$2
			shift 2
			;;
		--routing)
			[ "$#" -ge 2 ] && [ -n "$2" ] || die '--routing needs a value'
			routing=$2
			shift 2
			;;
		-h | --help)
			usage
			return 0
			;;
		*) die "unknown option for verify: $1" ;;
		esac
	done

	resolve_family "$family"
	report_family
	family=$FAMILY
	dir=$(family_dir "$family")
	assert_cache_exists "$dir" "$family"
	repo="$dir/repo"

	[ -n "$routing" ] || routing=$(default_routing_file)
	[ -f "$routing" ] || die "no routing table at $routing"

	note 'verify checks structure only — a publication that vanished, an entry that moved, or an entry delisted from its own index. A content refresh that leaves every path in place is invisible to it.'

	rows=$(mktemp "$dir/.verify-rows.XXXXXX")
	staging=$(mktemp "$dir/.verify.XXXXXX")
	trap 'rm -f "$rows" "$staging"' EXIT INT TERM

	grep -v '^[[:space:]]*#' "$routing" | grep -v '^[[:space:]]*$' >"$rows" || true

	available=$(upstream_publications "$repo")
	checked=0
	tab=$(printf '\t')

	while IFS="$tab" read -r concept publication entry_path _note; do
		: "$_note" # the routing table's note column; read for its width, not its value
		[ -n "$concept" ] || continue
		checked=$((checked + 1))

		if ! contains_line "$available" "$publication"; then
			verify_emit publication-missing "$concept" "$publication" "$entry_path" \
				"publication '$publication' no longer exists upstream for family '$family'" >>"$staging"
			continue
		fi

		if ! verify_entry_exists "$repo" "$publication" "$entry_path"; then
			verify_emit entry-missing "$concept" "$publication" "$entry_path" \
				"entry topic '$entry_path' has moved or disappeared from publication '$publication'" >>"$staging"
			continue
		fi

		if ! verify_entry_linked "$repo" "$publication" "$entry_path"; then
			verify_emit unlinked-from-index "$concept" "$publication" "$entry_path" \
				"entry topic '$entry_path' is no longer linked from '$publication''s index" >>"$staging"
		fi
	done <"$rows"

	rm -f "$rows"

	discrepancies=$(wc -l <"$staging" | tr -d '[:space:]')

	printf '{\n'
	printf '  "family": "%s",\n' "$(json_escape "$family")"
	printf '  "routing": "%s",\n' "$(json_escape "$routing")"
	printf '  "checked": %s,\n' "$checked"
	printf '  "discrepancies": [\n'
	_first=1
	while IFS= read -r _record; do
		[ -n "$_record" ] || continue
		if [ "$_first" -eq 1 ]; then
			_first=0
		else
			printf ',\n'
		fi
		printf '    %s' "$_record"
	done <"$staging"
	[ "$_first" -eq 1 ] || printf '\n'
	printf '  ]\n'
	printf '}\n'

	rm -f "$staging"
	trap - EXIT INT TERM

	if [ "$discrepancies" -gt 0 ]; then
		note "$discrepancies of $checked routing entries have drifted from upstream"
		return 1
	fi
	note "$checked routing entries verified clean against upstream"
}

# ----------------------------------------------------------------------- main

[ "$#" -gt 0 ] || {
	usage >&2
	exit 2
}

command=$1
shift

case $command in
sync) cmd_sync "$@" ;;
widen) cmd_widen "$@" ;;
refresh) cmd_refresh "$@" ;;
status) cmd_status "$@" ;;
index) cmd_index "$@" ;;
family) cmd_family "$@" ;;
verify) cmd_verify "$@" ;;
help | -h | --help) usage ;;
*)
	printf 'sndocs: unknown command: %s\n\n' "$command" >&2
	usage >&2
	exit 2
	;;
esac
